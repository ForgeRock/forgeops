file_name = Path(__file__)
current_file_path = file_name.parent.resolve()
root_path = [parent_path for parent_path in current_file_path.parents if (parent_path / 'README.md').exists()][0]
dependencies_dir = os.path.join(root_path, 'lib', 'dependencies')
# Insert lib folders to python path
sys.path.insert(0, str(root_path))
sys.path.insert(1, str(dependencies_dir) + site.USER_SITE.replace(site.USER_BASE, ''))

from lib.python.ensure_configuration_is_valid_or_exit import ensure_configuration_is_valid_or_exit, \
    print_how_to_install_dependencies

# First ensure configure has been executed
try:
    ensure_configuration_is_valid_or_exit()
except Exception as e:
    try:
        print(f'[error] {str(e)}')
    except Exception as exc:
        raise e from exc
    sys.exit(1)

import lib.python.common as common
from lib.python import utils


KUBECTL = shutil.which("kubectl")


class ArgFormatter(argparse.ArgumentDefaultsHelpFormatter, argparse.RawDescriptionHelpFormatter):
    pass


def check_prereqs(args):
    """ Check to make sure we have required params """

    if not getattr(args, 'pod', None):
        utils.exit_msg("Must provide a DS pod to connect to")
    if not getattr(args, 'command', None):
        utils.exit_msg("Must provide at least one dsconfig argument")


def craft_opt_str(opts):
    """
    Create a string out of array of dsconfig options
      * loop over array
      * if a string contains spaces, put it in quotes
    """

    opt_str = ''
    for o in opts:
        if o == '--':
            continue
        opt_str = f"{opt_str} {shlex.quote(o)}"
    return opt_str


def setup_args():
    """ Setup argparser """
    prog = "forgeops dsconfig"
    desc = "Run dsconfig commands against a pod"
    epilog = f"""
Notes:
  * Strings with spaces must be handled 1 of these ways
    * Double quoted
    * Quotes escaped
    * Quoted and spaces escaped

Examples:
  List plugins and specify the namespace:
  {prog} -n my-ns ds-idrepo-0 -- list-plugins

  Get plugin properties with double quoted string:
  {prog} ds-idrepo-0 -- get-plugin-prop --plugin-name "'Plugin Name'"

  Get plugin properties with escaped quotes:
  {prog} ds-idrepo-0 -- get-plugin-prop --plugin-name \\"Plugin Name\\"

  Get plugin properties with escaped spaces and quotes:
  {prog} ds-idrepo-0 -- get-plugin-prop --plugin-name "Plugin\\ Name"

  Do a dryrun:
  {prog} --dryrun ds-idrepo-0 -- list-plugins
"""

    common_args = common.setup_args()
    parser = argparse.ArgumentParser(description=desc,
                                     epilog=epilog,
                                     prog=prog,
                                     parents=[common_args['debug'],
                                              common_args['dryrun'],
                                              common_args['namespace']],
                                     formatter_class=ArgFormatter)
    parser.add_argument('pod',
                        help="DS pod to connect to")
    parser.add_argument('command',
                        nargs=argparse.REMAINDER,
                        help="dsconfig subcommand and options")
    return parser.parse_args()


def run(params):
    """ Run command logic """
    check_prereqs(params)
    namespace = utils.get_namespace()
    if getattr(params, 'namespace', None):
        namespace = params.namespace
    namespace_opt = f"-n {namespace}"
    pass_file = f"/tmp/{uuid.uuid4()}"
    admin_pass = utils.get_secret_value(namespace, 'ds-passwords', 'dirmanager\\\\.pw')
    with open(pass_file, "w", encoding='utf-8') as f:
        f.write(admin_pass)
    conn_str = "-h localhost -p 1636 --trustAll"
    user_str = "-D 'uid=admin'"
    pass_str = f"--bindPassword:file {pass_file}"
    if params.debug:
        print(f"command = {params.command}")
    dsconfig_opts = craft_opt_str(params.command)
    extra_opts = "--no-prompt"
    dsconfig = f"dsconfig {conn_str} {user_str} {pass_str} {extra_opts} {dsconfig_opts}"
    cmd_opts = f"exec {namespace_opt} {params.pod} -- "

    try:
        print(f"Copying password file to /tmp on {params.pod}.")
        utils.run(KUBECTL, f"cp {namespace_opt} {pass_file} {params.pod}:{pass_file} --no-preserve=true",
                  dryrun=params.dryrun,
                  debug=params.debug)
    except:
        print(f"ERROR!!! Unable to copy {pass_file} to {params.pod}. Exiting.", file=sys.stderr)
        sys.exit(1)
    try:
        utils.run(KUBECTL, f"{cmd_opts} {dsconfig}",
                  dryrun=params.dryrun,
                  debug=params.debug)
    except:
        print(f"ERROR!!! The dsconfig command failed, cleaning up '{pass_file}'.", file=sys.stderr)
    try:
        print(f"Deleting password file from {params.pod}")
        utils.run(KUBECTL, f"exec {namespace_opt} {params.pod} -- rm {pass_file}",
                  dryrun=params.dryrun,
                  debug=params.debug)
    except:
        print(f"ERROR!!! Unable to delete {pass_file} from {params.pod}. Remove it manually.",
              file=sys.stderr)
        sys.exit(1)
    try:
        print(f"Deleting {pass_file} from the local system.")
        utils.run('rm', pass_file,
                  dryrun=params.dryrun,
                  debug=params.debug)
    except:
        print(f"ERROR!!! Unable to delete {pass_file} from the local system. Remove it manually.",
              file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    args = setup_args()
    run(args)
